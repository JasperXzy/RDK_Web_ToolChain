{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://d-robotics.local/rdkwt/contracts/1.0/request.schema.json",
  "title": "RDK WebToolChain Runner Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "run_id",
    "attempt",
    "adapter",
    "runner_mode",
    "pipeline",
    "paths",
    "configuration",
    "limits"
  ],
  "properties": {
    "contract_version": {"const": "1.0"},
    "run_id": {"type": "string", "format": "uuid"},
    "attempt": {"type": "integer", "minimum": 1},
    "adapter": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "runner_mode": {"enum": ["cpu", "gpu"]},
    "pipeline": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "contains": {"const": "collect"},
      "minContains": 1,
      "maxContains": 1,
      "items": {
        "enum": ["inspect", "check", "preprocess", "compile", "verify", "collect"]
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "calibration_source", "attempt_root"],
      "properties": {
        "model": {"$ref": "#/$defs/logicalPath"},
        "calibration_source": {
          "oneOf": [{"$ref": "#/$defs/logicalPath"}, {"type": "null"}]
        },
        "attempt_root": {"$ref": "#/$defs/logicalPath"}
      }
    },
    "configuration": {"type": "object"},
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_seconds", "max_log_bytes"],
      "properties": {
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "max_log_bytes": {"type": "integer", "minimum": 1024, "maximum": 1073741824}
      }
    }
  },
  "$defs": {
    "logicalPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    }
  }
}
