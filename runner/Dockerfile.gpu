ARG OE_BASE_IMAGE=registry.d-robotics.cc/deliver/ai_toolchain_ubuntu_22_s100_s600_gpu:v3.7.0
FROM ${OE_BASE_IMAGE}

COPY runner/rdkwt_runner /opt/rdkwt-runner/rdkwt_runner

ENV HOME=/tmp/rdkwt-home \
    MPLCONFIGDIR=/tmp/matplotlib \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/opt/rdkwt-runner \
    PYTHONUNBUFFERED=1 \
    RDKWT_ASSETS_ROOT=/assets \
    RDKWT_RUNS_ROOT=/runs \
    XDG_CACHE_HOME=/tmp/cache

WORKDIR /runs
ENTRYPOINT ["python3", "-m", "rdkwt_runner"]
